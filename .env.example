# URL completa do webhook n8n (Production URL)
# Exemplo: https://seu-n8n.app/webhook/workshop-chat
VITE_N8N_WEBHOOK_URL=

# Opcional: proxy no dev para evitar CORS
# Defina a base do n8n (sem /webhook/...) e use no front:
# VITE_N8N_WEBHOOK_URL=/api/n8n/webhook/workshop-chat
VITE_N8N_PROXY_TARGET=
