# URL de teste (workflow em modo teste no n8n)
# https://nat11106.app.n8n.cloud/webhook-test/553deedb-f1a2-4b1f-8833-82a9e51096c5

# URL de produção (workflow ativo)
# https://nat11106.app.n8n.cloud/webhook/553deedb-f1a2-4b1f-8833-82a9e51096c5

# Desenvolvimento: proxy evita CORS
VITE_N8N_PROXY_TARGET=https://nat11106.app.n8n.cloud
VITE_N8N_WEBHOOK_URL=/api/n8n/webhook-test/553deedb-f1a2-4b1f-8833-82a9e51096c5

# URL pública do site (obrigatório em dev local se o n8n cloud baixar o áudio).
# Use o domínio do Netlify em produção, ou ngrok apontando para localhost:5173.
# VITE_PUBLIC_BASE_URL=https://worshopn8n.netlify.app

# TTL dos ficheiros de áudio temporários (horas, opcional; padrão 24)
# AUDIO_TTL_HOURS=24

# Netlify / produção (proxy no netlify.toml, sem CORS):
# VITE_N8N_WEBHOOK_URL=/api/n8n/webhook/553deedb-f1a2-4b1f-8833-82a9e51096c5

# Produção sem Netlify (URL direta; pode exigir CORS no n8n):
# VITE_N8N_PROXY_TARGET=
# VITE_N8N_WEBHOOK_URL=https://nat11106.app.n8n.cloud/webhook/553deedb-f1a2-4b1f-8833-82a9e51096c5
